generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Tenant {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  phone     String   @default("")
  logoUrl   String?
  jobPrefix       String  @default("SE")
  tokenPrefix     String  @default("TK")
  tokenResetDaily Boolean @default(false)
  status          String  @default("active") // active|suspended
  createdAt DateTime @default(now())

  customers             Customer[]
  jobCards              JobCard[]
  tokenCards            TokenCard[]
  technicians           Technician[]
  staffUsers            StaffUser[]
  staffDevices          StaffDevice[]
  lookupOptions         LookupOption[]
  applianceTechnicians  ApplianceTechnician[]
  applianceAccessories  ApplianceAccessory[]
  applianceBrands       ApplianceBrand[]
  applianceComplaints   ApplianceComplaint[]
  outsourcePartners     OutsourcePartner[]
  printJobs             PrintJob[]
  shopPrinters          ShopPrinter[]
  staffAlerts           StaffAlert[]
  notificationSettings  NotificationSettings?
  notificationTemplates NotificationTemplate[]
  notificationLogs      NotificationLog[]
  whatsAppConversations WhatsAppConversation[]
  whatsAppMessages      WhatsAppMessage[]
  jobSequence           JobSequence?
  tokenSequence         TokenSequence?
}

model Customer {
  id                         String    @id @default(cuid())
  tenantId                   String
  tenant                     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                       String?
  mobile                     String
  address                    String?
  allowWhatsappNotifications Boolean   @default(true)
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
  jobCards                   JobCard[]
  tokenCards                 TokenCard[]
  whatsAppConversations      WhatsAppConversation[]

  @@unique([tenantId, mobile])
  @@index([tenantId])
}

enum JobStatus {
  Pending
  WaitingForCustomerApproval
  Outsourced
  WarrantyPending
  WarrantyWithCompany
  JobCompleted
  Ready
  Return
  Delivered
}

enum DeliveryContactStatus {
  not_contacted
  contacted
}

model LookupOption {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category String
  value    String

  @@unique([tenantId, category, value])
  @@index([tenantId, category])
}

model Technician {
  id                String                @id @default(cuid())
  tenantId          String
  tenant            Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name              String
  active            Boolean               @default(true)
  assignedJobs      JobCard[]             @relation("AssignedTechnician")
  completedJobs     JobCard[]             @relation("CompletedByTechnician")
  assignedTokens    TokenCard[]           @relation("AssignedTokenTechnician")
  completedTokens   TokenCard[]           @relation("CompletedTokenTechnician")
  applianceMappings ApplianceTechnician[]
  staffUsers        StaffUser[]
  createdAt         DateTime              @default(now())

  @@unique([tenantId, name])
  @@index([tenantId])
}

enum StaffRole {
  reception
  technician
  admin
  verifier
}

enum DevicePlatform {
  android
  web
}

enum DeviceStatus {
  pending
  approved
  revoked
}

model StaffUser {
  id              String        @id @default(cuid())
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  mobile          String        @unique
  passwordHash    String
  name            String
  role            StaffRole
  active          Boolean       @default(true)
  technicianId    String?
  technician      Technician?   @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  devices         StaffDevice[] @relation("StaffDevices")
  approvedDevices StaffDevice[] @relation("ApprovedByStaff")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([tenantId])
  @@index([role])
  @@index([technicianId])
}

model StaffDevice {
  id           String         @id @default(cuid())
  tenantId     String
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staffUserId  String
  staffUser    StaffUser      @relation("StaffDevices", fields: [staffUserId], references: [id], onDelete: Cascade)
  deviceId     String
  deviceLabel  String?
  platform     DevicePlatform
  status       DeviceStatus   @default(pending)
  lastSeenAt   DateTime       @default(now())
  approvedAt   DateTime?
  approvedById String?
  approvedBy   StaffUser?     @relation("ApprovedByStaff", fields: [approvedById], references: [id], onDelete: SetNull)
  createdAt    DateTime       @default(now())

  @@unique([staffUserId, deviceId])
  @@index([tenantId])
  @@index([status])
  @@index([staffUserId])
}

model ApplianceTechnician {
  id            String     @id @default(cuid())
  tenantId      String
  tenant        Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  applianceType String
  technicianId  String
  technician    Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  @@unique([tenantId, applianceType])
  @@index([tenantId])
}

model ApplianceBrand {
  id            String @id @default(cuid())
  tenantId      String
  tenant        Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  applianceType String
  brand         String

  @@unique([tenantId, applianceType, brand])
  @@index([tenantId, applianceType])
}

model ApplianceComplaint {
  id            String @id @default(cuid())
  tenantId      String
  tenant        Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  applianceType String
  complaint     String

  @@unique([tenantId, applianceType, complaint])
  @@index([tenantId, applianceType])
}

model ApplianceAccessory {
  id            String @id @default(cuid())
  tenantId      String
  tenant        Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  applianceType String
  accessory     String

  @@unique([tenantId, applianceType, accessory])
  @@index([tenantId, applianceType])
}

model OutsourcePartner {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String
  active         Boolean   @default(true)
  outsourcedJobs JobCard[] @relation("OutsourcedTo")
  completedJobs  JobCard[] @relation("CompletedByOutsource")
  createdAt      DateTime  @default(now())

  @@unique([tenantId, name])
  @@index([tenantId])
}

model JobCard {
  id                            String                @id @default(cuid())
  tenantId                      String
  tenant                        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  jobNumber                     String
  customerId                    String
  customer                      Customer              @relation(fields: [customerId], references: [id])
  applianceType                 String
  brand                         String
  model                         String?
  complaint                     String
  physicalCondition             String?
  productPhotos                 String?
  warrantyCardPhotos            String?
  accessories                   String?
  serviceAmount                 Float?
  serviceCharge                 Float?
  serviceKind                   String?
  sparesAmount                  Float?
  status                        JobStatus             @default(Pending)
  remarks                       String?
  whatsappNotificationsOverride Boolean?
  rackDetail                    String?
  receivedAt                    DateTime              @default(now())
  completedAt                   DateTime?
  readyAt                       DateTime?
  deliveredAt                   DateTime?
  deliveryContactStatus         DeliveryContactStatus @default(not_contacted)
  expectedDeliveryAt            DateTime?
  createdBy                     String?
  assignedTechnicianId          String?
  assignedTechnician            Technician?           @relation("AssignedTechnician", fields: [assignedTechnicianId], references: [id])
  completedByTechnicianId       String?
  completedByTechnician         Technician?           @relation("CompletedByTechnician", fields: [completedByTechnicianId], references: [id])
  outsourcedToId                String?
  outsourcedTo                  OutsourcePartner?     @relation("OutsourcedTo", fields: [outsourcedToId], references: [id], onDelete: SetNull)
  outsourcedAt                  DateTime?
  completedByOutsourceId        String?
  completedByOutsource          OutsourcePartner?     @relation("CompletedByOutsource", fields: [completedByOutsourceId], references: [id], onDelete: SetNull)
  isWarranty                    Boolean               @default(false)
  warrantyPurchaseDate          DateTime?
  warrantyTakenAt               DateTime?
  createdAt                     DateTime              @default(now())
  updatedAt                     DateTime              @updatedAt
  statusHistory                 StatusHistory[]
  printJobs                     PrintJob[]
  staffAlerts                   StaffAlert[]
  notificationLogs              NotificationLog[]
  whatsAppMessages              WhatsAppMessage[]

  @@unique([tenantId, jobNumber])
  @@index([tenantId])
  @@index([customerId])
  @@index([status])
  @@index([assignedTechnicianId])
  @@index([assignedTechnicianId, status, receivedAt])
  @@index([status, receivedAt])
  @@index([completedByTechnicianId])
  @@index([outsourcedToId])
  @@index([completedByOutsourceId])
  @@index([isWarranty])
  @@index([brand])
  @@index([receivedAt])
}

model StatusHistory {
  id        String    @id @default(cuid())
  jobCardId String
  jobCard   JobCard   @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  status    JobStatus
  note      String?
  changedBy String?
  changedAt DateTime  @default(now())

  @@index([jobCardId])
}

model JobSequence {
  id       String @id @default(cuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lastNum  Int    @default(0)
}

enum TokenStatus {
  Pending
  JobCompleted
  Ready
  Delivered
}

model TokenSequence {
  id          String  @id @default(cuid())
  tenantId    String  @unique
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lastNum     Int     @default(0)
  lastResetOn String?
}

model TokenCard {
  id                      String      @id @default(cuid())
  tenantId                String
  tenant                  Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tokenNumber             String
  customerId              String
  customer                Customer    @relation(fields: [customerId], references: [id])
  applianceType           String
  brand                   String
  model                   String?
  complaint               String
  physicalCondition       String?
  productPhotos           String?
  accessories             String?
  remarks                 String?
  serviceAmount           Float?
  serviceCharge           Float?
  serviceKind             String?
  sparesAmount            Float?
  status                  TokenStatus @default(Pending)
  estimatedMinutes        Int
  receivedAt              DateTime    @default(now())
  completedAt             DateTime?
  readyAt                 DateTime?
  deliveredAt             DateTime?
  createdBy               String?
  assignedTechnicianId    String?
  assignedTechnician      Technician? @relation("AssignedTokenTechnician", fields: [assignedTechnicianId], references: [id])
  completedByTechnicianId String?
  completedByTechnician   Technician? @relation("CompletedTokenTechnician", fields: [completedByTechnicianId], references: [id])
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt
  printJobs               PrintJob[]
  staffAlerts             StaffAlert[]

  @@unique([tenantId, tokenNumber])
  @@index([tenantId])
  @@index([customerId])
  @@index([status])
  @@index([assignedTechnicianId])
  @@index([receivedAt])
}

model StaffAlert {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role       StaffRole?
  userId     String?
  type       String
  title      String
  body       String?
  jobCardId  String?
  jobCard    JobCard?  @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  tokenId    String?
  tokenCard  TokenCard? @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([tenantId, role, readAt])
  @@index([tenantId, createdAt])
}

model ShopPrinter {
  id        String  @id @default(cuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  printerId String
  purposes  String  @default("[\"job_receipt\"]")
  active    Boolean @default(true)
  createdAt DateTime @default(now())

  @@unique([tenantId, printerId])
  @@index([tenantId])
}

enum PrintJobStatus {
  Pending
  Printing
  Printed
  Failed
}

model PrintJob {
  id           String         @id @default(cuid())
  tenantId     String
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  jobCardId    String?
  jobCard      JobCard?       @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  tokenCardId  String?
  tokenCard    TokenCard?     @relation(fields: [tokenCardId], references: [id], onDelete: Cascade)
  type         String         @default("receipt")
  payload      Json?
  status       PrintJobStatus @default(Pending)
  branchId     String         @default("main")
  printerId    String         @default("counter-1")
  attempts     Int            @default(0)
  errorMessage String?
  createdAt    DateTime       @default(now())
  printedAt    DateTime?

  @@index([tenantId])
  @@index([branchId, printerId, status, createdAt])
  @@index([status, createdAt])
}

enum NotificationEventType {
  JOB_CREATED
  JOB_READY
  JOB_RETURN
}

enum NotificationChannel {
  WHATSAPP
  SMS
  EMAIL
  PUSH
}

enum NotificationDeliveryStatus {
  Pending
  Sent
  Failed
  Skipped
}

enum WhatsAppProviderType {
  meta
  interakt
  twilio
  custom
}

model NotificationSettings {
  id                        String               @id @default(cuid())
  tenantId                  String               @unique
  tenant                    Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  masterEnabled             Boolean              @default(true)
  jobCreatedEnabled         Boolean              @default(true)
  jobReadyEnabled           Boolean              @default(true)
  jobReturnEnabled          Boolean              @default(true)
  trackingLinkEnabled       Boolean              @default(true)
  provider                  WhatsAppProviderType @default(meta)
  apiUrl                    String?
  apiKey                    String?
  accessToken               String?
  phoneNumberId             String?
  whatsappBusinessAccountId String?
  businessNumber            String?
  additionalHeaders         String?
  updatedAt                 DateTime             @updatedAt
}

model NotificationTemplate {
  id        String                @id @default(cuid())
  tenantId  String
  tenant    Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  eventType NotificationEventType
  body      String
  updatedAt DateTime              @updatedAt

  @@unique([tenantId, eventType])
  @@index([tenantId])
}

model NotificationLog {
  id          String                     @id @default(cuid())
  tenantId    String
  tenant      Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  jobCardId   String
  jobCard     JobCard                    @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  eventType   NotificationEventType
  channel     NotificationChannel        @default(WHATSAPP)
  status      NotificationDeliveryStatus
  recipient   String
  messageBody String?
  provider    String?
  externalId  String?
  error       String?
  manual      Boolean                    @default(false)
  createdAt   DateTime                   @default(now())

  @@index([tenantId])
  @@index([jobCardId, eventType, channel])
  @@index([createdAt])
}

enum WhatsAppMessageDirection {
  inbound
  outbound
}

enum WhatsAppMessageType {
  text
  image
  reaction
  unsupported
}

enum WhatsAppMessageStatus {
  received
  sent
  failed
}

model WhatsAppConversation {
  id                 String            @id @default(cuid())
  tenantId           String
  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerMobile     String
  customerId         String?
  customer           Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lastMessageAt      DateTime          @default(now())
  lastMessagePreview String?
  unreadCount        Int               @default(0)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  messages           WhatsAppMessage[]

  @@unique([tenantId, customerMobile])
  @@index([tenantId])
  @@index([lastMessageAt])
}

model WhatsAppMessage {
  id                String                   @id @default(cuid())
  tenantId          String
  tenant            Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversationId    String
  conversation      WhatsAppConversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction         WhatsAppMessageDirection
  wamid             String                   @unique
  messageType       WhatsAppMessageType
  body              String?
  mediaId           String?
  reactedToWamid    String?
  status            WhatsAppMessageStatus
  sentByStaffUserId String?
  jobCardId         String?
  jobCard           JobCard?                 @relation(fields: [jobCardId], references: [id], onDelete: SetNull)
  rawPayload        String?
  createdAt         DateTime                 @default(now())

  @@index([tenantId])
  @@index([conversationId, createdAt])
}
