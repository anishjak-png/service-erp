# Supabase (PostgreSQL) — required for all environments
# Create a project at https://supabase.com → Settings → Database → Connection string
#
# Pooler URL (port 6543) — used by the app at runtime (Vercel, local dev)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
#
# Direct URL (port 5432) — used by Prisma for db push / migrations
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

SESSION_SECRET="change-this-to-a-long-random-string-min-32-chars"
RECEPTION_PIN="1234"
TECHNICIAN_PIN="5678"
ADMIN_PIN="9999"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# On Vercel, APP_URL auto-resolves from VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL when unset.
# Set NEXT_PUBLIC_APP_URL to your custom domain if you use one (e.g. https://your-app.vercel.app).
# Set to "true" to show service amounts on reception dashboard ready-for-pickup list
SHOW_AMOUNTS_TO_RECEPTION="false"
NEXT_PUBLIC_SHOP_NAME="Your Shop"
NEXT_PUBLIC_SHOP_PHONE=""
JOB_NUMBER_PREFIX="SE"
# Optional fallback when host/query do not provide a tenant slug (local/single-tenant preview)
# DEFAULT_TENANT_SLUG="demo"

# Bootstrap admin on seed (demo tenant)
# ADMIN_MOBILE="9876543210"
# ADMIN_PASSWORD="change-me"

# Supabase Storage — product photo uploads (optional)
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_STORAGE_BUCKET="product-photos"

# LAN printing — Windows Print Bridge on shop PC (Supabase Realtime, no polling)
PRINT_BRANCH_ID="main"
PRINT_PRINTER_ID="counter-1"
# Shop PC .env — see .env.shop.example and docs/PRINT_SETUP.md

# Meta Cloud API — optional default recipient for admin "Test Connection"
# META_TEST_RECIPIENT_PHONE="919876543210"
# Approved WhatsApp template language locale (default: en — hello_world Test Connection uses en_US separately)
# META_TEMPLATE_LANGUAGE_CODE="en"

# WhatsApp — set true only when Meta Cloud API is configured for this environment
WHATSAPP_ENABLED=false

# WhatsApp inbound webhook (customer replies → Admin → Inbox)
# Choose any random string; same value goes in Meta Developer → WhatsApp → Configuration → Verify token
WHATSAPP_WEBHOOK_VERIFY_TOKEN="your-random-verify-token"
# Meta App → Settings → Basic → App secret (validates X-Hub-Signature-256 on webhook POST)
META_APP_SECRET="your-meta-app-secret"
