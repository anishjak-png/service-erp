# Copy to shop PC as `.env` — run INSTALL.bat once
# Get Supabase values from Dashboard → Settings → API (do not share keys in chat).

SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Print bridge — must match Vercel PRINT_BRANCH_ID / PRINT_PRINTER_ID
BRANCH_ID="main"
PRINTER_ID="counter-1"

# LAN thermal printer (never hardcode in code — set here only)
PRINTER_IP="192.168.1.87"
PRINTER_PORT="9100"
PRINTER_NAME="Counter Printer"

# Optional
HEALTH_PORT="3005"

NEXT_PUBLIC_APP_URL="https://uma-service.vercel.app"
NEXT_PUBLIC_SHOP_NAME="Uma Traders"
NEXT_PUBLIC_SHOP_PHONE="9842241388"

# Legacy names still supported: PRINT_BRANCH_ID, PRINT_PRINTER_ID, THERMAL_PRINTER_HOST, THERMAL_PRINTER_PORT
